# Copy to .env for local testing only — never commit the real file.
# In GitHub Actions these are repo/org *secrets*, not env files.

# Tried first by orchestrator/runners.py (cost reasons).
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Fallback backend if Gemini is unavailable or its run fails. Also reused
# as-is for the Phase 4 blast-radius step later. Leave unset if you're using
# the Pro/Max subscription fallback instead (see CLAUDE_CODE_OAUTH_CREDS
# below and docs/claude-subscription-fallback.md).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative to ANTHROPIC_API_KEY: a restored Claude.ai Pro/Max subscription
# OAuth session (GitHub Actions secret only — see
# docs/claude-subscription-fallback.md for how this is produced and its
# risk tradeoffs. Never put the real value in this file or anywhere local).
CLAUDE_CODE_OAUTH_CREDS=

GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
